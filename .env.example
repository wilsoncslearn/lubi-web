# npm run setup generates a unique password in .env.local. Do not commit it.
LUBI_PASSWORD=replace-with-a-long-unique-password
# Paths are relative to the repository root; existing legacy paths are preserved.
LUBI_DB_PATH=./data/lubi.db
HOST=127.0.0.1
PORT=3000
WEB_PORT=5173
# Explicit opt-in for an AI server on this same machine (e.g. Ollama).
LUBI_ALLOW_LOCAL_AI=0
# Behind a correctly configured HTTPS reverse proxy only:
LUBI_HTTPS=0
LUBI_TRUST_PROXY=0
# LUBI_PUBLIC_URL=https://your-private-domain.example
# Optional server key location; default is beside the SQLite database.
# LUBI_KEY_PATH=./data/lubi-credentials.key
# Never prefix passwords or secrets with VITE_.
